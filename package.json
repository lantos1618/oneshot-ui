    "dist/*.css",
    "dist-single/ui.tsx",
    "dist-single/ui-content.tsx",
    "dist-single/ui-charts.tsx",
    "dist-single/ui-ai.tsx",
    "dist-single/ui-all.tsx",
    "dist-single/SHA256SUMS",
    "dist-registry/index.json",
    "dist-registry/SHA256SUMS",
    "dist-registry/files/*.tsx",
    "bin/lyndon-ui.mjs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && pnpm build:css && pnpm build:single && pnpm build:registry",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode utils && vite build --config vite.lib.config.ts --mode utils-extras && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "build:css": "tailwindcss -i src/lib/styles.css -o dist/styles.css --minify && tailwindcss -i src/lib/preflight.css -o dist/preflight.css --minify && node scripts/build-tokens.mjs",
    "build:single": "node scripts/build-single.mjs && tsc -p tsconfig.single.json --noEmit",
    "build:registry": "node scripts/build-registry.mjs",
    "build:demo": "tsc -b && vite build",
    "docs:dev": "node scripts/build-docs-data.mjs && vite --config docs/vite.config.ts",
    "docs:build": "node scripts/build-docs.mjs",
    "test:ssr": "node scripts/ssr-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "test:e2e:update-baseline": "node tests/e2e/update-baseline.mjs",
    "test:pack": "node tests/pack-check.mjs",
    "test:registry": "node scripts/check-registry.mjs",
    "prepublishOnly": "pnpm build && pnpm test:ssr",
    "typecheck": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:docs": "node scripts/build-docs-data.mjs && tsc -p docs/tsconfig.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "pnpm lint && tsc -b && pnpm typecheck:tests && pnpm build && pnpm typecheck:docs && pnpm test:registry && pnpm test:ssr && pnpm test && pnpm test:pack"
  },
  "peerDependencies": {
    "motion": "^13.0.0 || ^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.0",
    "motion": "^14.10.1",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
