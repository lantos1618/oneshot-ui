{
  "name": "@lyndon/ui",
  "version": "0.2.0",
  "description": "Animated React 19 components with themes, in the shadcn style: forms, overlays, data grids, charts, diagrams, maps, AI chat. Also ships as drop-in single files for AI tools.",
  "keywords": [
    "react",
    "react-19",
    "components",
    "ui",
    "design-system",
    "tailwind",
    "tailwindcss",
    "motion",
    "animation",
    "themes",
    "dark-mode",
    "charts",
    "shadcn",
    "ssr",
    "nextjs"
  ],
  "author": "Lyndon Leong",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/lantos1618/oneshot-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lantos1618/oneshot-ui.git"
  },
  "bugs": {
    "url": "https://github.com/lantos1618/oneshot-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./playground": {
      "types": "./dist/playground.d.ts",
      "default": "./dist/playground.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "default": "./dist/overlay.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./datagrid": {
      "types": "./dist/datagrid.d.ts",
      "default": "./dist/datagrid.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./code": {
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./aichat": {
      "types": "./dist/aichat.d.ts",
      "default": "./dist/aichat.js"
    },
    "./aiagent": {
      "types": "./dist/aiagent.d.ts",
      "default": "./dist/aiagent.js"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "default": "./dist/collab.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./diagrams": {
      "types": "./dist/diagrams.d.ts",
      "default": "./dist/diagrams.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "default": "./dist/appearance.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./styles.css": "./dist/styles.css",
    "./preflight.css": "./dist/preflight.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/*.css",
    "dist-single/ui.tsx",
    "dist-single/ui-content.tsx",
    "dist-single/ui-charts.tsx",
    "dist-single/ui-ai.tsx",
    "dist-single/ui-all.tsx",
    "dist-single/SHA256SUMS",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:lib && pnpm build:css && pnpm build:single",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode utils && tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "build:css": "tailwindcss -i src/lib/styles.css -o dist/styles.css --minify && tailwindcss -i src/lib/preflight.css -o dist/preflight.css --minify && node scripts/build-tokens.mjs",
    "build:single": "node scripts/build-single.mjs && tsc -p tsconfig.single.json --noEmit",
    "build:demo": "tsc -b && vite build",
    "test:ssr": "node scripts/ssr-check.mjs",
    "prepublishOnly": "pnpm build && pnpm test:ssr",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "motion": "^13.0.0 || ^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "motion": "^14.10.1",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
