exports[`exporters: snapshots > custom dark palette > css 1`] = `
"/* Custom · @lyndon/ui theme · CSS variables */
:root {
  --bg: #101418;
  --card: #1A1B26;
  --muted: #262734;
  --line: #313443;
  --line2: #424558;
  --fg: #C0CAF5;
  --fg2: #868DAD;
  --fg3: #7F85A3;
  --primary: #7AA2F7;
  --on-primary: #16161E;
  --accent: #F472B6;
  --accent-soft: #412B40;
  --ok: #9ECE6A;
  --ok-soft: #323B32;
  --warn: #E0AF68;
  --warn-soft: #3E3632;
  --bad: #F7768E;
  --bad-soft: #422B39;
  --c1: #C0CAF5;
  --c2: #F472B6;
  --c3: #FF9E64;
  --c4: #9ECE6A;
  --c-neutral: #7E84A2;
  --band: rgba(244,114,182,0.18);
  --shadow: 0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.5);
  --r-sm: 2px;
  --r-md: 4px;
  --r-lg: 7px;
  --font: "Manrope",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme: dark;
}
"
`;

