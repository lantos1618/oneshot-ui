"/* Default (Light / Dark) · @lyndon/ui theme · CSS variables */
:root {
  --bg: #FAFAFA;
  --card: #FFFFFF;
  --muted: #F4F4F5;
  --line: #E4E4E7;
  --line2: #D4D4D8;
  --fg: #09090B;
  --fg2: #52525B;
  --fg3: #68686F;
  --primary: #18181B;
  --on-primary: #FAFAFA;
  --accent: #2563EB;
  --accent-soft: #E5ECFD;
  --ok: #15803D;
  --ok-soft: #E3F0E8;
  --warn: #B45309;
  --warn-soft: #F6EAE1;
  --bad: #DC2626;
  --bad-soft: #FBE5E5;
  --c1: #09090B;
  --c2: #2563EB;
  --c3: #F97316;
  --c4: #15803D;
  --c-neutral: #6B6B6D;
  --band: rgba(37,99,235,0.13);
  --shadow: 0 1px 2px rgba(0,0,0,.04),0 10px 30px rgba(0,0,0,.08);
  --r-sm: 4px;
  --r-md: 8px;
  --r-lg: 14px;
  --font: "Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #09090B;
    --card: #111113;
    --muted: #1A1A1D;
    --line: #27272A;
    --line2: #3F3F46;
    --fg: #FAFAFA;
    --fg2: #A1A1AA;
    --fg3: #8E8E98;
    --primary: #FAFAFA;
    --on-primary: #09090B;
    --accent: #60A5FA;
    --accent-soft: #1F2C3D;
    --ok: #4ADE80;
    --ok-soft: #1B3627;
    --warn: #FBBF24;
    --warn-soft: #3B3016;
    --bad: #F87171;
    --bad-soft: #3B2224;
    --c1: #FAFAFA;
    --c2: #60A5FA;
    --c3: #FB923C;
    --c4: #4ADE80;
    --c-neutral: #9D9D9E;
    --band: rgba(96,165,250,0.18);
    --shadow: 0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.5);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #09090B;
  --card: #111113;
  --muted: #1A1A1D;
  --line: #27272A;
  --line2: #3F3F46;
  --fg: #FAFAFA;
  --fg2: #A1A1AA;
  --fg3: #8E8E98;
  --primary: #FAFAFA;
  --on-primary: #09090B;
  --accent: #60A5FA;
  --accent-soft: #1F2C3D;
  --ok: #4ADE80;
  --ok-soft: #1B3627;
  --warn: #FBBF24;
  --warn-soft: #3B3016;
  --bad: #F87171;
  --bad-soft: #3B2224;
  --c1: #FAFAFA;
  --c2: #60A5FA;
