exports[`exporters: snapshots > default theme > tailwind 1`] = `
"/* Default (Light / Dark) · @lyndon/ui theme · Tailwind CSS v4 */
@custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));

@theme {
  --color-bg: #FAFAFA;
  --color-card: #FFFFFF;
  --color-muted: #F4F4F5;
  --color-line: #E4E4E7;
  --color-line2: #D4D4D8;
  --color-fg: #09090B;
  --color-fg2: #52525B;
  --color-fg3: #68686F;
  --color-primary: #18181B;
  --color-on-primary: #FAFAFA;
  --color-accent: #2563EB;
  --color-accent-soft: #E5ECFD;
  --color-ok: #15803D;
  --color-ok-soft: #E3F0E8;
  --color-warn: #B45309;
  --color-warn-soft: #F6EAE1;
  --color-bad: #DC2626;
  --color-bad-soft: #FBE5E5;
  --color-c1: #09090B;
  --color-c2: #2563EB;
  --color-c3: #F97316;
  --color-c4: #15803D;
  --color-c-neutral: #6B6B6D;
  --color-band: rgba(37,99,235,0.13);
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 14px;
  --font-sans: "Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  --font-mono: "Geist Mono",ui-monospace,"SF Mono",Menlo,monospace;
  --shadow-card: 0 1px 2px rgba(0,0,0,.04),0 10px 30px rgba(0,0,0,.08);
}

@layer theme {
  :root, :host {
    @variant dark {
      --color-bg: #09090B;
      --color-card: #111113;
      --color-muted: #1A1A1D;
      --color-line: #27272A;
      --color-line2: #3F3F46;
      --color-fg: #FAFAFA;
      --color-fg2: #A1A1AA;
      --color-fg3: #8E8E98;
      --color-primary: #FAFAFA;
      --color-on-primary: #09090B;
      --color-accent: #60A5FA;
      --color-accent-soft: #1F2C3D;
      --color-ok: #4ADE80;
      --color-ok-soft: #1B3627;
      --color-warn: #FBBF24;
      --color-warn-soft: #3B3016;
      --color-bad: #F87171;
      --color-bad-soft: #3B2224;
      --color-c1: #FAFAFA;
      --color-c2: #60A5FA;
      --color-c3: #FB923C;
      --color-c4: #4ADE80;
      --color-c-neutral: #9D9D9E;
      --color-band: rgba(96,165,250,0.18);
      --shadow-card: 0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.5);
    }
  }
}
"
`;

